{
  "name": "@skilleddragon/minilab-skills-lock-verify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SkilledDragon minilab: vercel-labs/skills lock hash verify (OK/DRIFT/MISSING)",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.2.0"
  },
  "bin": {
    "skill-lock-verify": "./bin/skill-lock-verify.ts"
  },
  "scripts": {
    "test": "bun test ./tests",
